    {
      "id": "chr-fc-35c8",
      "sourceText": "ここでは なにも とれない",
      "translation": "这里什么也拿不到。",
      "pages": [
        { "lines": ["這裡什麼也拿不到。"] }
      ],
      "segments": [
        {
          "sourceStart": 0,
          "sourceEndExclusive": 13,
